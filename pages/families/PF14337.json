{"cross_mech":[{"cited_uniprot_accession":"","family_mentioned_in_record":null,"link_basis":["record_mentions_previous_pfam_name"],"pfam_id":"PF14337","protein_label":"","reviewed":null,"short_name":"Abi_alpha","source_category":"genomics","source_mech":"TraitMech","source_path":"data/traits/genomics/abialpha_system.yaml","source_record_id":"traitmech:000322","source_record_label":"AbiAlpha system","source_section":"record_text","taxon_id":"","taxon_label":"","uniprot_accession":"","unknown_status":"EX_DUF"}],"family":{"alphafold_models":693,"candidate_reasons":["pfam_previous_unknown_name"],"characterization_status":"","context_evidence_count":null,"cross_mech":{"example_proteins":0,"protein_traits_record":false,"records_by_mech":{"TraitMech":1},"scanned":false},"curation_status":"SEEDED","demotion_reasons":[],"description":"Enterococci such as Enterococcus faecalis and Enterococcus faecium are part of the normal human gut microbiota. However they can also be a source of nosocomial infections specially in immunocompromised patients. Virulent bacteriophages, i.e., viruses that infect and obligatorily lyse bacteria might provide alternative options for combating them. Yet, bacterial resistance to phage is taking place in similar fashion to antibiotic resistance. This might be, in part due to temperate phages that are stably associated with their host. They compete for their bacterial host, in addition to repressor-dependent immunity against similar phages, some phage express genes conferring resistance to infection by more or less unrelated phages. They can encode abortive infection (Abi) mechanisms that cause an interruption of invasive phage development and a premature death of the infected bacteria. For instance, E. faecalis V583 prophage 6 confers resistance to the virulent phage Idefix infection mainly due to Abia-alpha protein. This Pfam family corresponds to Abi-alpha protein sequences which is mostly found in prophages, arguing that it is essentially a temperate phage weapon to fight against other phages [[cite:PUB00101291]].","domain_architectures":2,"interpro_id":"IPR025506","known_evidence_count":null,"matches":1144,"name":"Abortive infection alpha","partial_evidence_count":null,"pfam_id":"PF14337","proteins":1144,"proteomes":945,"short_name":"Abi_alpha","source_url":"https://www.ebi.ac.uk/interpro/api/entry/pfam/PF14337","structures":1,"taxa":1811,"unknown_status":"EX_DUF"},"inputs":{"cross_mech":"cross-mech-duf-examples-2026-10-10","members":"pfam-uniprot-uniref90-2026-10-07","protein_examples":"duf-protein-examples-direct-2026-10-13","worklist":"interpro-pfam-duf-2026-10-10"},"members":[],"metadata":{"curation_status":"SEEDED","local_source":"source/data/families/PF14337.yaml","record":{"characterization_status":"UNSCORED","counters":{"alphafold_models":693,"domain_architectures":2,"matches":1144,"proteins":1144,"proteomes":945,"structures":1,"taxa":1811},"curation_status":"SEEDED","description":"Enterococci such as Enterococcus faecalis and Enterococcus faecium are part of the normal human gut microbiota. However they can also be a source of nosocomial infections specially in immunocompromised patients. Virulent bacteriophages, i.e., viruses that infect and obligatorily lyse bacteria might provide alternative options for combating them. Yet, bacterial resistance to phage is taking place in similar fashion to antibiotic resistance. This might be, in part due to temperate phages that are stably associated with their host. They compete for their bacterial host, in addition to repressor-dependent immunity against similar phages, some phage express genes conferring resistance to infection by more or less unrelated phages. They can encode abortive infection (Abi) mechanisms that cause an interruption of invasive phage development and a premature death of the infected bacteria. For instance, E. faecalis V583 prophage 6 confers resistance to the virulent phage Idefix infection mainly due to Abia-alpha protein. This Pfam 