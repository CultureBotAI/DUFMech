{"cross_mech":[],"family":{"alphafold_models":4529,"candidate_reasons":["pfam_previous_unknown_name"],"characterization_status":"","context_evidence_count":null,"cross_mech":{"example_proteins":0,"protein_traits_record":false,"records_by_mech":{},"scanned":false},"curation_status":"SEEDED","demotion_reasons":[],"description":"This entry includes MYG1 exonuclease from human and its orthologues. MYG1 is a 3'-5' exonuclease which cleaves in situ on specific transcripts in both nucleus and mitochondrion. It is involved in regulating spatially segregated organellar RNA processing, acting as a coordinator of nucleo-mitochondrial crosstalk [[cite:PUB00155300]]. In nucleolus, processes pre-ribosomal RNA involved in ribosome assembly and alters cytoplasmic translation. In mitochondrial matrix, it processes 3'-termini of the mito-ribosomal and messenger RNAs and controls translation of mitochondrial proteins [[cite:PUB00155300]]. Overexpression of MYG1 has been associated with the autoimmune disorder vitiligo, suggesting that MYG1 may play some role in human innate immunity [[cite:PUB00155301]]. Studies in yeast suggested a potential antiviral function of MYG1 [[cite:PUB00155302]].","domain_architectures":89,"interpro_id":"IPR003226","known_evidence_count":null,"matches":5764,"name":"Uncharacterised protein family (UPF0160)","partial_evidence_count":null,"pfam_id":"PF03690","proteins":5549,"proteomes":4320,"short_name":"MYG1_exonuc","source_url":"https://www.ebi.ac.uk/interpro/api/entry/pfam/PF03690","structures":21,"taxa":10390,"unknown_status":"EX_DUF"},"inputs":{"cross_mech":"cross-mech-duf-examples-2026-10-10","members":"pfam-uniprot-uniref90-2026-10-07","protein_examples":"duf-protein-examples-direct-2026-10-13","worklist":"interpro-pfam-duf-2026-10-10"},"members":[],"metadata":{"curation_status":"SEEDED","local_source":"source/data/families/PF03690.yaml","record":{"characterization_status":"UNSCORED","counters":{"alphafold_models":4529,"domain_architectures":89,"matches