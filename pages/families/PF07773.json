1619-pf07773.yaml","source_record_id":"Pfam:PF07773","source_record_label":"Tectonic domain of DUF1619","source_section":"trait_identifier","taxon_id":"","taxon_label":"","uniprot_accession":"","unknown_status":"KNOWN_HISTORICAL_DUF"}],"family":{"alphafold_models":2961,"candidate_reasons":["name_matches_duf"],"characterization_status":"","context_evidence_count":null,"cross_mech":{"example_proteins":7,"protein_traits_record":true,"records_by_mech":{"ProteinTraitsMech":7},"scanned":true},"curation_status":"SEEDED","demotion_reasons":[],"description":"This is a conserved domain found in tectonic proteins (TCTN1/2/3) which contains conserved cysteine residues predicted to form disulfide bond. This domain is found in two tandem copies. It is predicted to fold into an alpha/beta structure with unique topology composed of a central mixed beta-sheet and alpha-helix packed on it. Although function of this domain is currently unknown, studies on TCTN2 suggest that it is indispensable for its functions [[cite:PUB00097826],[cite:PUB00097827]]. TCTN1, TCTN2, and TCTN3 are members of the tectonic protein family that play crucial roles in ciliogenesis and ciliary function. While they share some common functions, each protein also has specific roles in the process of cilia formation and maintenance. These proteins interact with several other ciliopathy proteins, forming a complex known as the Tectonic ciliopathy complex. This complex is required for hedgehog signalling transduction and regulation of ciliary membrane composition [[cite:PUB00069722],[cite:PUB00160606]].","domain_architectures":51,"interpro_id":"IPR011677","known_evidence_count":null,"matches":6251,"name":"Tectonic domain of DUF1619","partial_evidence_count":null,"pfam_id":"PF07773","proteins":3441,"proteomes":1145,"short_name":"TCTN_DUF1619","source_url":"https://www.ebi.ac.uk/interpro/api/entry/pfam/PF07773","structures":0,"taxa":3864,"unknown_status":"KNOWN_HISTORICAL_DUF"},"inputs":{"cross_mech":"cross-mech-duf-examples-2026-10-08","members":"pfam-uniprot-uniref90-2026-10-07","worklist":"interpro-pfam-duf-2026-10-08"},"members":[],"metadata":{"curation_status":"SEEDED","local_source":"source/data/families/PF07773.yaml","record":{"characterization_status":"UNSCORED","counters":{"alphafold_models":2961,"domain_architectures":51,"matches":6251,"proteins":3441,"proteomes":1145,"structures":0,"taxa":3864},"curation_status":"SEEDED","description":"This is a conserved domain found in tectonic proteins (TCTN1/2/3) which contains conserved cysteine residues predicted to form disulfide bond. This domain is found in two tandem copies. It is predicted to fold into an alpha/beta structure with unique topology composed of a central mixed beta-sheet and alpha-helix packed on it. Although function of this domain is currently unknown, studies on TCTN2 suggest that it is indispensable for its functions [[cite:PUB00097826],[cite:PUB00097827]]. TCTN1, TCTN2, and TCTN3 are members of the tectonic protein family that play crucial roles in ciliogenesis and ciliary function. While they share some common functions, each protein also has specific roles in the process of cilia formation and maintenance. These proteins interact with several other ciliopathy proteins, forming a complex known as the Tectonic ciliopathy complex. This complex is required for hedgehog signalling transduction and regulation of ciliary membrane composition [[cite:PUB00069722],[cite:PUB00160606]].","id":"Pfam:PF07773","interpro_id":"InterPro:IPR011677","name":"Tectonic domain of DUF1619","pfam_id":"PF07773","provenance":{"generated_at":"2026-10-08T02:48:09.822970Z","path":"data/worklists/interpro-pfam-duf-2026-10-08.json","sha256":"9f0992961c30c5d92343a92aab000cd20b6c4213952b4c68408c3065779a46ec","snapshot_id":"interpro-pfam-duf-2026-10-08","source_url":"https://www.ebi.ac.uk/interpro/api/entry/pfam/"},"seed_status":"KNOWN_HISTORICAL_DUF","short_name":"TCTN_DUF1619","source_url":"https://www.ebi.ac.uk/interpro/api/entry/pfam/