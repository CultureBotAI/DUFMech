{"cross_mech":[],"family":{"alphafold_models":5072,"candidate_reasons":["pfam_previous_unknown_name"],"characterization_status":"","context_evidence_count":null,"cross_mech":{"example_proteins":0,"protein_traits_record":false,"records_by_mech":{},"scanned":false},"curation_status":"SEEDED","demotion_reasons":[],"description":"This entry, previously known as DUF11, represents the CLIPPER domain, (Cross-Linked IsoPeptide Protein in the Extracellular Region) which is usually found in multiple copies in a number of archaebacterial proteins. CLIPPER domain adopts an Ig-like fold and contains a conserved N-terminal lysine and a C-terminal asparagine with central aspartate/glutamate residues that form an intramolecular isopeptide bond [[cite:PUB00163642]]. The positions of the residues predicted to form isopeptide bonds are not universally conserved suggesting that some domains appear to lack the intramolecular isopeptide bonds. CLIPPER domains are found in proteins from Gram-positive and Gram-negative bacteria. Some have also been identified in multiple cell-surface proteins from archaea. In Methanothermobacter sp. CaT2, this domain plays a key role as a membrane-bound adhesion protein in the aggregation of CaT2 [[cite:PUB00097782]].","domain_architectures":3336,"interpro_id":"IPR001434","known_evidence_count":null,"matches":33340,"name":"CLIPPER domain","partial_evidence_count":null,"pfam_id":"PF01345","proteins":12543,"proteomes":5220,"short_name":"CLIPPER","source_url":"https://www.ebi.ac.uk/interpro/api/entry/pfam/PF01345","structures":1,"taxa":8073,"unknown_status":"EX_DUF"},"inputs":{"cross_mech":"cross-mech-duf-examples-2026-10-10","members":"pfam-uniprot-uniref90-2026-10-07","protein_examples":"duf-protein-examples-2026-10-13","worklist":"interpro-pfam-duf-2026-10-10"},"members":[],"metadata":{"curation_status":"SEEDED","local_source":"source/data/families/PF01345.yaml","record":{"characterization_status":"UNSCORED","counters":{"alphafold_models":5072,"domain_arch